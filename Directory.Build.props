<!-- SPDX-License-Identifier: MPL-2.0 -->

<Project>
  <PropertyGroup>
    <RelayBridgeVersion>1.0.0-rc.1</RelayBridgeVersion>
    <Version Condition="'$(Version)' == ''">$(RelayBridgeVersion)</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <Authors>RelayBridge contributors</Authors>
    <Company>RelayBridge contributors</Company>
    <Product>RelayBridge</Product>
    <Description>Local SMTP-to-Microsoft-365 OAuth relay</Description>
    <Copyright>Copyright © 2026 RelayBridge contributors</Copyright>
  </PropertyGroup>
</Project>
