@page "/settings"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@using Microsoft.Extensions.Options
@using RelayBridge.Core.Release
@using RelayBridge.Host.Services
@using RelayBridge.Infrastructure.Queue
@using RelayBridge.Infrastructure.Smtp
@inject IWebHostEnvironment HostEnvironment
@inject IJSRuntime JavaScript
@inject IOptions<SmtpListenerOptions> Listener
@inject IOptions<QueueOptions> Queue
@inject DeviceEndpointAdvisor Endpoints
@inject PrinterConnectivityApplyCoordinator PrinterApply
@inject ReleaseAwarenessService ReleaseAwareness

<PageTitle>Settings · RelayBridge</PageTitle>

<div class="page-heading"><div><p class="eyebrow">Local service</p><h1>Settings</h1><p class="lead">Current listener, printer-connectivity requirements, and management safety boundaries.</p></div></div>

<section class="settings-preview" aria-labelledby="software-version-heading">
    <div><p class="eyebrow">Software</p><h2 id="software-version-heading">Version and releases</h2></div>
    <dl class="stacked-details connectivity-details">
        <div><dt>RelayBridge version</dt><dd>@ReleaseAwareness.CurrentVersion</dd></div>
        <div><dt>Release channel</dt><dd>@ReleaseAwareness.Channel</dd></div>
        <div><dt>Update status</dt><dd>@ReleaseStatusText</dd></div>
        <div><dt>Last checked</dt><dd>@LastCheckedText</dd></div>
        @if (ReleaseAwareness.LastResult?.AvailableVersion is { } available)
        {
            <div><dt>New version</dt><dd>@available</dd></div>
            <div><dt>Released</dt><dd>@ReleasedText</dd></div>
        }
    </dl>
    <div class="actions">
        <button class="button secondary" @onclick="CheckForUpdatesAsync" disabled="@_checking">
            @(_checking ? "Checking…" : ReleaseAwareness.Status == ReleaseCheckStatus.NotChecked ? "Check for updates" : "Check again")
        </button>
        @if (ReleaseAwareness.LastResult?.ReleaseUri is { } releaseUri)
        {
            <a class="button primary" href="@releaseUri.AbsoluteUri" target="_blank" rel="noopener noreferrer">View release</a>
        }
    </div>
    <p class="card-note">Update checks contact GitHub directly for published RelayBridge release metadata. No Microsoft tenant, device, message, or RelayBridge configuration data is sent. RelayBridge does not download or install updates.</p>
    <p class="card-note">Checks occur only when an administrator selects <strong>Check for updates</strong>. RelayBridge does not contact GitHub automatically.</p>
</section>

<section id="printer-connectivity" class="settings-preview" aria-labelledby="printer-connectivity-heading">
    <div><p class="eyebrow">Required before adding an authenticated printer</p><h2 id="printer-connectivity-heading">Printer connectivity</h2></div>
    @if (Advice.IsAuthenticatedSmtpAvailable)
    {
        <div class="notice success" role="status">Authenticated printer SMTP is ready on the configured trusted private LAN.</div>
    }
    else
    {
        <div class="warning-panel">
            <strong>Deployment configuration and restart required</strong>
            <p>The SMTP listener is bound only when RelayBridge starts. Update the service deployment configuration with an explicit private address, enable compatible SMTP authentication, and restart RelayBridge. This page does not change the running listener.</p>
        </div>
    }

    <dl class="stacked-details connectivity-details">
        <div><dt>Current listener</dt><dd><code>@Listener.Value.ListenAddress:@Listener.Value.Port</code></dd></div>
        <div><dt>LAN printer reachability</dt><dd>@(Advice.IsLanReachable ? "Ready" : "Needs attention")</dd></div>
        <div><dt>Authenticated printer SMTP</dt><dd>@(Advice.IsAuthenticatedSmtpAvailable ? "Ready" : "Needs attention")</dd></div>
        <div><dt>Inbound TLS</dt><dd>Not available</dd></div>
    </dl>

    @if (!Advice.IsAuthenticatedSmtpAvailable)
    {
        <h3>Available private interfaces</h3>
        @if (Advice.AvailableCandidates.Count == 0)
        {
            <p class="guidance">No active private LAN interface was found. Connect this server to the printer's trusted private network before configuring the listener.</p>
        }
        else
        {
            <p class="guidance">Choose the explicit address reachable from the printers. RelayBridge cannot prove printer reachability, and private virtual or VPN interfaces may not be usable from the printer network. Do not use a public address or <code>0.0.0.0</code>.</p>
            <ul class="address-list">
                @foreach (var candidate in Advice.AvailableCandidates)
                {
                    <li>
                        @if (Advice.AvailableCandidates.Count > 1)
                        {
                            <input type="radio" name="printer-interface" value="@candidate.Address" checked="@(_selectedAddress == candidate.Address.ToString())" @onchange="() => _selectedAddress = candidate.Address.ToString()" aria-label="@($"Use {candidate.Address} on {candidate.InterfaceName}")" />
                        }
                        <code>@candidate.Address</code><span>@candidate.InterfaceName · @candidate.InterfaceType</span>
                    </li>
                }
            </ul>
            @if (_selectedAddress is null)
            {
                <p class="notice" role="status">Select the private interface that the printers can reach before RelayBridge generates deployment configuration.</p>
            }
            else
            {
                <div class="warning-panel" role="status">
                    <strong>NOT YET APPLIED</strong>
                    <p>RelayBridge has generated the configuration only. Review it, then apply this exact configuration through Windows administrator confirmation.</p>
                </div>
                <h3>Generated printer-connectivity configuration</h3>
                <pre class="configuration-example"><code>@ConfigurationExample</code></pre>
                <div class="actions">
                    <button class="button primary" @onclick="ApplyConfigurationAsync" disabled="@_applying">@(_applying ? "Waiting for administrator confirmation…" : "Apply printer connectivity")</button>
                    <button class="button secondary" @onclick="DownloadConfigurationAsync">Download configuration</button>
                    <button class="button secondary" @onclick="CopyConfigurationAsync">Copy configuration</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_notice))
                {
                    <p class="notice" role="status">@_notice</p>
                }
                <dl class="stacked-details connectivity-details">
                    <div><dt>Configuration destination</dt><dd><code>@ConfigurationDestination</code></dd></div>
                    <div><dt>Queue processing after restart</dt><dd>Enabled</dd></div>
                    <div><dt>Changes currently applied</dt><dd>No</dd></div>
                </dl>
                <details class="technical-details">
                    <summary>Advanced manual apply</summary>
                    <p class="guidance">If Windows administrator confirmation cannot start, run PowerShell as Administrator. If your browser saved the download elsewhere, adjust only the first command's source path.</p>
                    <pre class="configuration-example"><code>@AdministratorCommands</code></pre>
                </details>
                <h3>Windows Firewall</h3>
                <p class="guidance">The installer intentionally does not create a firewall rule. If Windows Firewall blocks the printer, run this command manually as Administrator. It is limited to the RelayBridge Host executable, the selected local address and port, the Private profile, and the local subnet. Replace <code>LocalSubnet</code> with the printer's exact IP address or a narrower trusted subnet when appropriate.</p>
                <pre class="configuration-example"><code>@FirewallCommand</code></pre>
                <p class="guidance">This command is guidance only. RelayBridge has not changed Windows Firewall.</p>
            }
        }
    }

    <div class="warning-panel">
        <strong>Trusted private LAN only</strong>
        <p>Inbound STARTTLS is not available yet. Enabling SMTP authentication here sends the printer's reusable username and password without TLS on the local network. Keep the listener on one explicit trusted private interface and retain every device's IP and sender restrictions.</p>
    </div>
</section>

<section class="detail-grid">
    <article class="detail-card">
        <h2>SMTP listener</h2>
        <dl class="stacked-details">
            <div><dt>Address</dt><dd><code>@Listener.Value.ListenAddress</code></dd></div>
            <div><dt>Port</dt><dd>@Listener.Value.Port</dd></div>
            <div><dt>SMTP authentication</dt><dd>@(Listener.Value.AllowCleartextAuthentication ? "Enabled on trusted LAN" : "Disabled")</dd></div>
            <div><dt>Inbound STARTTLS</dt><dd>Not available</dd></div>
            <div><dt>Queue processing</dt><dd>@(Queue.Value.Enabled ? "Enabled" : "Disabled")</dd></div>
            <div><dt>Maximum message</dt><dd>@FormatBytes(Listener.Value.MaxMessageBytes)</dd></div>
        </dl>
    </article>
    <article class="detail-card">
        <h2>Management</h2>
        <dl class="stacked-details">
            <div><dt>Web access</dt><dd>Local computer only</dd></div>
            <div><dt>Printer address available</dt><dd>@(Advice.IsLanReachable ? "Yes" : "No")</dd></div>
        </dl>
        <p class="card-note">The management site remains loopback-only. SMTP listener and management binding are separate security surfaces.</p>
    </article>
</section>

<section class="settings-preview" aria-labelledby="after-restart-heading">
    <div><p class="eyebrow">Verification</p><h2 id="after-restart-heading">After the service restarts</h2></div>
    <ol>
        <li>Return to this page and confirm the listener shows the selected private address and port.</li>
        <li>Confirm <strong>Queue processing</strong> shows Enabled.</li>
        <li>Open <a href="/health">service health</a> and confirm it responds successfully.</li>
        <li>Open <a href="/diagnostics">Diagnostics</a> and confirm the SMTP listener is available and the active Microsoft configuration remains present.</li>
    </ol>
    <p class="guidance">The management UI remains available only from this computer. Restarting intentionally resets current-process Microsoft verification evidence; it does not delete the active Microsoft configuration.</p>
</section>

<div class="warning-panel">
    <strong>Trusted-LAN compatibility</strong>
    <p>Inbound TLS certificate provisioning is deferred. Do not expose RelayBridge SMTP to the Internet. Cleartext device authentication, when deliberately enabled, is suitable only for a trusted private network with strict per-device IP and sender restrictions.</p>
</div>

@code {
    private DeviceEndpointAdvice Advice = null!;
    private string? _selectedAddress;
    private string? _notice;
    private bool _applying;
    private bool _checking;
    protected override void OnInitialized()
    {
        Advice = Endpoints.GetAdvice();
        if (Advice.AvailableCandidates.Count == 1)
        {
            _selectedAddress = Advice.AvailableCandidates[0].Address.ToString();
        }
    }
    private string ConfigurationExample =>
        SmtpDeploymentConfiguration.Create(_selectedAddress!, Listener.Value.Port);
    private string ConfigurationDestination =>
        SmtpDeploymentConfiguration.GetEnvironmentOverridePath(
            HostEnvironment.ContentRootPath,
            HostEnvironment.EnvironmentName);
    private string DownloadFileName =>
        SmtpDeploymentConfiguration.GetDownloadFileName(HostEnvironment.EnvironmentName);
    private string AdministratorCommands =>
        SmtpDeploymentConfiguration.CreateAdministratorCommands(ConfigurationDestination, DownloadFileName);
    private string FirewallCommand =>
        SmtpDeploymentConfiguration.CreateFirewallCommand(
            _selectedAddress!,
            Listener.Value.Port,
            Path.Combine(AppContext.BaseDirectory, "RelayBridge.Host.exe"));
    private async Task DownloadConfigurationAsync()
    {
        await JavaScript.InvokeVoidAsync("relayBridge.downloadText", DownloadFileName, ConfigurationExample);
        _notice = $"Downloaded {DownloadFileName}. The configuration is still not applied.";
    }
    private async Task ApplyConfigurationAsync()
    {
        if (_applying || _selectedAddress is null)
        {
            return;
        }

        _applying = true;
        var preparation = PrinterApply.Prepare(_selectedAddress);
        _notice = preparation.Message;
        if (!preparation.Succeeded || preparation.LaunchUri is null)
        {
            _applying = false;
            return;
        }

        await JavaScript.InvokeVoidAsync("relayBridge.launchPrinterApply", preparation.LaunchUri);
    }
    private async Task CopyConfigurationAsync()
    {
        await JavaScript.InvokeVoidAsync("relayBridge.copyText", ConfigurationExample);
        _notice = "Copied the generated configuration. It is still not applied.";
    }
    private async Task CheckForUpdatesAsync()
    {
        if (_checking)
        {
            return;
        }

        _checking = true;
        try
        {
            await ReleaseAwareness.CheckNowAsync();
        }
        finally
        {
            _checking = false;
        }
    }
    private string ReleaseStatusText => ReleaseAwareness.Status switch
    {
        ReleaseCheckStatus.Checking => "Checking",
        ReleaseCheckStatus.UpToDate => "Up to date",
        ReleaseCheckStatus.UpdateAvailable => "Update available",
        ReleaseCheckStatus.CouldNotCheck => "Could not check for updates",
        _ => "Not checked",
    };
    private string LastCheckedText => ReleaseAwareness.LastResult?.CheckedUtc.ToLocalTime()
        .ToString("d MMM yyyy, h:mm tt") ?? "Not available";
    private string ReleasedText => ReleaseAwareness.LastResult?.PublishedUtc?.ToLocalTime()
        .ToString("d MMM yyyy") ?? "Not available";
    private static string FormatBytes(long bytes) => $"{bytes / (1024d * 1024d):0.#} MiB";
}
